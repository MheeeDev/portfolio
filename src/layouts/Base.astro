---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../site';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  /** Language of the page's main content. Thai articles pass 'th'. */
  lang?: 'en' | 'th';
  /** Share image path under the site, e.g. 'og/<slug>.png'. Defaults to the profile photo. */
  image?: string;
  /** 'article' for blog posts; everything else is a website page. */
  type?: 'website' | 'article';
  /** Extra schema.org data for search engines, e.g. a BlogPosting. */
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.tagline, lang = 'en', image, type = 'website', jsonLd } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.headline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const shareImage = image ?? site.avatar;
const imageUrl = shareImage ? new URL(url(shareImage), Astro.site).href : undefined;
// Who runs the site, on every page, so search engines can tie the articles and projects to one person.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'เค้ก',
  jobTitle: site.headline,
  url: new URL(url(), Astro.site).href,
  email: `mailto:${site.email}`,
  image: site.avatar ? new URL(url(site.avatar), Astro.site).href : undefined,
  sameAs: site.links.map((l) => l.href),
};
const nav = [
  { href: url(), label: 'Home', exact: true },
  { href: url('blog/'), label: 'Blog' },
  { href: url('videos/'), label: 'Videos' },
  { href: url('projects/'), label: 'Projects' },
  { href: url('about/'), label: 'About' },
  { href: url('contact/'), label: 'Contact' },
];
const current = (n: (typeof nav)[number]) => (n.exact ? path === n.href : path.startsWith(n.href));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_US'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <!-- Apply the saved light/dark choice before first paint so the page does not flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header no-print">
      <div class="wrap wide bar">
        <a class="brand" href={url()} aria-label={`${site.domain} — home`}>
          <span class="mark" aria-hidden="true">a</span>
          <span class="domain">{site.domain}</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer no-print">
      <div class="wrap wide foot">
        <span class="muted">© {new Date().getFullYear()} {site.name} · {site.slogan}</span>
        <span class="links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
          <a href={url('rss.xml')}>RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<script>
  // Header gets a shadow once the page is scrolled.
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Reveal [data-reveal] elements as they enter the viewport.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  // A page opened in the background (or by a preview/screenshot tool) shows everything at once.
  document.querySelectorAll('[data-reveal]').forEach((el) => (document.hidden ? el.classList.add('is-visible') : io.observe(el)));

  // Pointer-following light on .spot cards.
  document.addEventListener('pointermove', (e) => {
    const card = e.target instanceof Element ? e.target.closest<HTMLElement>('.spot') : null;
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', `${e.clientX - r.left}px`);
    card.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(160%) blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.2s, box-shadow 0.2s; view-transition-name: site-header; }
  .site-header.scrolled { border-bottom-color: var(--line); box-shadow: 0 6px 20px rgb(0 0 0 / 0.06); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--text); text-decoration: none; justify-self: start; }
  .mark { position: relative; display: inline-grid; place-items: center; width: 26px; height: 26px; border: 1.5px solid currentColor; border-radius: 7px; font-family: var(--mono); font-size: 0.85rem; font-weight: 500; line-height: 1; }
  /* The dot is a "running" status LED, like on a PLC. */
  .mark::after { content: ''; position: absolute; right: -4px; bottom: -4px; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6); }
  @media (prefers-reduced-motion: no-preference) {
    .mark::after { animation: led 2.4s ease-out infinite; }
  }
  @keyframes led { 0% { box-shadow: 0 0 0 0 rgb(34 197 94 / 0.55); } 70%, 100% { box-shadow: 0 0 0 7px rgb(34 197 94 / 0); } }
  .domain { font-family: var(--mono); font-size: 0.88rem; }
  nav { display: flex; gap: 0.2rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.92rem; font-weight: 500; padding: 0.35rem 0.7rem; border-radius: 8px; white-space: nowrap; }
  nav a:hover { color: var(--text); background: var(--chip); }
  nav a[aria-current='page'] { color: var(--accent); }
  .bar > :global(.theme-toggle) { justify-self: end; }
  /* Phones: brand and toggle on top, the menu scrolls sideways underneath. */
  @media (max-width: 820px) {
    .bar { grid-template-columns: 1fr auto; padding-top: 0.6rem; gap: 0.4rem; }
    nav { grid-column: 1 / -1; grid-row: 2; overflow-x: auto; margin: 0 -16px; padding: 0 10px 0.4rem; scrollbar-width: none; -webkit-mask-image: linear-gradient(to right, #000 85%, transparent); mask-image: linear-gradient(to right, #000 85%, transparent); }
    nav::-webkit-scrollbar { display: none; }
  }
  main { min-height: 70vh; }
  .site-footer { border-top: 1px solid var(--line); margin-top: 5rem; font-size: 0.88rem; }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem 1.5rem; padding-top: 1.5rem; padding-bottom: 2rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
  .links a { color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--accent); }
</style>
