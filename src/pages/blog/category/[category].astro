---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { categories, getPosts, type Category } from '../../../lib';

// One page per category that has at least one post.
export async function getStaticPaths() {
  const posts = await getPosts();
  return categories
    .filter((c) => posts.some((p) => p.data.category === c.id))
    .map((c) => ({ params: { category: c.id }, props: { label: c.label } }));
}

const category = Astro.params.category as Category;
const { label } = Astro.props;
const all = await getPosts();
const posts = all.filter((p) => p.data.category === category);
---
<Base title={`${label} — Blog`} description={`Articles about ${label}.`}>
  <PostList posts={posts} all={all} current={category} />
</Base>
