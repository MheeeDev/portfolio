---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import Callout from '../../components/mdx/Callout.astro';
import Checklist from '../../components/mdx/Checklist.astro';
import SkillLoop from '../../components/mdx/SkillLoop.astro';
import SkillMap from '../../components/mdx/SkillMap.astro';
import PidExplainer from '../../components/mdx/PidExplainer.astro';
import ReactionCurve from '../../components/mdx/ReactionCurve.astro';
import TankSim from '../../components/mdx/TankSim.astro';
import TuneLab from '../../components/mdx/TuneLab.astro';
import TestMatrix from '../../components/mdx/TestMatrix.astro';
import TwinSwitch from '../../components/mdx/TwinSwitch.astro';
import Quote from '../../components/mdx/Quote.astro';
import StatStrip from '../../components/mdx/StatStrip.astro';
import ChemBridge from '../../components/mdx/ChemBridge.astro';
import CareerSfc from '../../components/mdx/CareerSfc.astro';
import TraitScan from '../../components/mdx/TraitScan.astro';
import { categoryLabel, formatDate, getPosts, url, type Post } from '../../lib';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first, so the next-older post is i + 1
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const d = post.data;
// These components work inside .mdx articles without an import line.
const components = { YouTube, Callout, Checklist, SkillLoop, SkillMap, TankSim, TestMatrix, TwinSwitch, ReactionCurve, TuneLab, PidExplainer, Quote, StatStrip, ChemBridge, CareerSfc, TraitScan };
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
// Thai has no spaces between words, so estimate from characters (~900 a minute) rather than words.
const text = (post.body ?? '').replace(/<[^>]+>|[#*`>{}\[\]()]/g, '');
const minutes = Math.max(1, Math.round(text.replace(/\s+/g, '').length / 900));
const initials = site.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
// Articles with a cover get a PNG share image from /og/<id>.png; the rest fall back to the profile photo.
const shareImage = d.cover ? `og/${post.id}.png` : undefined;
const pageUrl = new URL(url(`blog/${post.id}/`), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString(),
  inLanguage: d.lang,
  keywords: d.tags.join(', '),
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  image: shareImage ? new URL(url(shareImage), Astro.site).href : undefined,
  author: { '@type': 'Person', name: site.name, url: new URL(url('about/'), Astro.site).href },
  ...(d.youtube && {
    video: {
      '@type': 'VideoObject',
      name: d.title,
      description: d.summary,
      thumbnailUrl: `https://i.ytimg.com/vi/${d.youtube}/hqdefault.jpg`,
      uploadDate: d.date.toISOString(),
      embedUrl: `https://www.youtube-nocookie.com/embed/${d.youtube}`,
    },
  }),
};
---
<Base title={d.title} description={d.summary} lang={d.lang} type="article" image={shareImage} jsonLd={jsonLd}>
  <div class="progress no-print" aria-hidden="true"></div>

  <header class="post-hero">
    <div class="wrap wide inner">
      <p class="back rise" style="--i:0" lang="en"><a href={url('blog/')}>← All articles</a></p>
      <p class="meta rise" style="--i:1" lang="en">
        <a class="cat" href={url(`blog/category/${d.category}/`)}>{categoryLabel(d.category)}</a>
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
        <span>{minutes} min read</span>
        {d.draft && <span class="draft">Draft — not published</span>}
      </p>
      <h1 class="rise" style="--i:2">{d.title}</h1>
      <p class="lead rise" style="--i:3">{d.summary}</p>
      <p class="byline rise" style="--i:4" lang="en">
        {site.avatar ? <img src={url(site.avatar)} alt="" width="36" height="36" /> : <span class="ini">{initials}</span>}
        <span><strong>{site.name}</strong><br /><span class="muted">{site.headline}</span></span>
      </p>
    </div>
  </header>

  <div class="wrap wide">
    {d.youtube ? (
      <div class="media"><YouTube id={d.youtube} title={d.title} /></div>
    ) : d.cover && (
      <figure class="media cover"><Image src={d.cover} alt={d.coverAlt ?? ''} width={1600} /></figure>
    )}

    <div class="layout">
      <article class="prose">
        <Content components={components} />
        {d.tags.length > 0 && <ul class="chips tags">{d.tags.map((t) => <li class="chip">#{t}</li>)}</ul>}
      </article>

      {toc.length > 1 && (
        <aside class="toc no-print" aria-label="On this page">
          <p class="toc-title" lang="en">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </aside>
      )}
    </div>

    <aside class="author spot" lang="en">
      {site.avatar ? <img src={url(site.avatar)} alt="" width="64" height="64" /> : <span class="ini big">{initials}</span>}
      <div>
        <p><strong>{site.name}</strong> · {site.headline}</p>
        <p class="muted">{site.tagline}</p>
        <p class="links"><a href={url('projects/')}>See my projects →</a><a href={url('contact/')}>Get in touch →</a></p>
      </div>
    </aside>

    <nav class="pager" aria-label="More articles">
      {older ? <a class="spot" href={url(`blog/${older.id}/`)} lang={older.data.lang}><span lang="en">← Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="spot next" href={url(`blog/${newer.id}/`)} lang={newer.data.lang}><span lang="en">Newer →</span>{newer.data.title}</a>}
    </nav>
  </div>
</Base>

<script>
  // Reading progress: the bar under the header fills as the article is read.
  const bar = document.querySelector<HTMLElement>('.progress');
  const article = document.querySelector<HTMLElement>('.prose');
  // Table of contents: highlight the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  const update = () => {
    if (bar && article) {
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / r.height));
      bar.style.transform = `scaleX(${p})`;
    }
    let current = -1;
    targets.forEach((t, i) => { if (t.getBoundingClientRect().top < innerHeight * 0.3) current = i; });
    links.forEach((a, i) => a.classList.toggle('on', i === current));
  };
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 20; transform-origin: 0 50%; transform: scaleX(0); background: linear-gradient(90deg, var(--accent), #a855f7, #22c55e); }

  .post-hero { position: relative; overflow: hidden; padding: 3rem 0 2.5rem; background: radial-gradient(60rem 26rem at 80% -20%, var(--bg-glow), transparent 70%); }
  .post-hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle, color-mix(in srgb, var(--muted) 24%, transparent) 1px, transparent 1.3px) 0 0 / 22px 22px; -webkit-mask-image: linear-gradient(to bottom, #000, transparent 90%); mask-image: linear-gradient(to bottom, #000, transparent 90%); }
  .inner { position: relative; max-width: 1100px; }
  .back { margin: 0 0 1.6rem; font-size: 0.92rem; }
  .back a { text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; font-size: 0.86rem; color: var(--muted); margin: 0; }
  .meta time, .meta span { font-family: var(--mono); }
  .cat { font-weight: 600; text-decoration: none; padding: 0.1rem 0.6rem; border-radius: 6px; background: var(--accent-soft); }
  .draft { background: #fde8c8; color: #7a4a00; border-radius: 4px; padding: 0 0.45rem; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3.6rem); font-weight: 800; margin: 0.8rem 0 0.8rem; max-width: 34ch; }
  .lead { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--muted); margin: 0; max-width: 52rem; }
  .byline { display: flex; align-items: center; gap: 0.8rem; margin: 1.6rem 0 0; font-size: 0.9rem; line-height: 1.4; }
  .byline img, .author img { border-radius: 50%; object-fit: cover; background: #fff; }
  .ini { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .ini.big { width: 64px; height: 64px; }

  .media { margin: 0 0 3rem; }
  .cover { border-radius: 22px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .cover :global(img) { width: 100%; }

  .layout { display: grid; grid-template-columns: minmax(0, 760px) 240px; justify-content: center; gap: 4rem; }
  @media (max-width: 1100px) { .layout { grid-template-columns: minmax(0, 760px); } .toc { display: none; } }
  .toc { position: sticky; top: 96px; align-self: start; font-size: 0.86rem; }
  .toc-title { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 0.6rem; }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .toc a { display: block; padding: 0.35rem 0 0.35rem 0.9rem; margin-left: -2px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; line-height: 1.5; }
  .toc a:hover { color: var(--text); }
  .toc a.on { color: var(--accent); border-left-color: var(--accent); }

  .prose { font-size: 1.06rem; min-width: 0; }
  .prose :global(h2) { font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 800; margin: 3rem 0 0.8rem; scroll-margin-top: 90px; }
  .prose :global(h3) { font-size: 1.2rem; margin: 2.2rem 0 0.5rem; scroll-margin-top: 90px; }
  .prose :global(hr) { border: 0; height: 1px; margin: 3rem 0; background: linear-gradient(90deg, transparent, var(--line), transparent); }
  .prose :global(img) { border: 1px solid var(--line); border-radius: var(--radius); margin: 1rem 0 0.3rem; }
  .prose :global(blockquote) { margin: 1.2rem 0; padding: 0.2rem 1rem; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(strong) { color: var(--text); }
  .tags { margin-top: 2.5rem; }

  .author { display: flex; gap: 1.2rem; align-items: center; max-width: 760px; margin: 3.5rem auto 0; padding: 1.4rem 1.5rem; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); overflow: hidden; }
  .author p { margin: 0.15rem 0; }
  .links { display: flex; gap: 1.2rem; flex-wrap: wrap; margin-top: 0.4rem !important; }
  .pager { max-width: 760px; margin: 2rem auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } }
  .pager a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--text); text-decoration: none; font-weight: 600; overflow: hidden; }
  .pager a span { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); font-weight: 400; }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; grid-column: 2; }
  @media (max-width: 600px) { .pager .next { grid-column: 1; } }
</style>
