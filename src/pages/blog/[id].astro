---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { categoryLabel, formatDate, getPosts, url, type Post } from '../../lib';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first, so the next-older post is i + 1
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const d = post.data;
// <YouTube /> works inside .mdx articles without an import line.
const { Content } = await render(post);
---
<Base title={d.title} description={d.summary} lang={d.lang}>
  <article class="wrap post">
    <p class="back" lang="en"><a href={url('blog/')}>← All articles</a></p>
    <header>
      <p class="meta" lang="en">
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
        <a href={url(`blog/category/${d.category}/`)}>{categoryLabel(d.category)}</a>
        {d.draft && <span class="draft">Draft — not published</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </header>

    {d.youtube ? (
      <YouTube id={d.youtube} title={d.title} />
    ) : d.cover && (
      <figure class="cover"><Image src={d.cover} alt={d.coverAlt ?? ''} width={1600} /></figure>
    )}

    <div class="prose"><Content components={{ YouTube }} /></div>

    {d.tags.length > 0 && <ul class="chips tags">{d.tags.map((t) => <li class="chip">#{t}</li>)}</ul>}

    <aside class="author" lang="en">
      <p><strong>{site.name}</strong> · {site.headline}</p>
      <p class="muted">{site.tagline}</p>
      <p><a href={url('projects/')}>See my projects</a> · <a href={url('contact/')}>Get in touch</a></p>
    </aside>

    <nav class="pager" aria-label="More articles">
      {older ? <a href={url(`blog/${older.id}/`)} lang={older.data.lang}>← {older.data.title}</a> : <span />}
      {newer && <a href={url(`blog/${newer.id}/`)} lang={newer.data.lang}>{newer.data.title} →</a>}
    </nav>
  </article>
</Base>

<style>
  .post { max-width: 820px; padding-top: 1.5rem; }
  .back { margin: 0 0 1.2rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; font-size: 0.85rem; color: var(--muted); margin: 0; }
  .meta time { font-family: var(--mono); }
  .meta a { font-weight: 600; text-decoration: none; }
  .draft { background: #fde8c8; color: #7a4a00; border-radius: 4px; padding: 0 0.45rem; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); margin: 0.4rem 0 0.6rem; }
  .lead { font-size: 1.12rem; color: var(--muted); margin: 0; }
  .cover { margin: 1.5rem 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .prose { margin-top: 1.5rem; font-size: 1.04rem; }
  .prose :global(h2) { font-size: 1.35rem; margin: 2.4rem 0 0.6rem; }
  .prose :global(h3) { font-size: 1.1rem; margin: 1.8rem 0 0.4rem; }
  .prose :global(img) { border: 1px solid var(--line); border-radius: var(--radius); margin: 1rem 0 0.3rem; }
  .prose :global(blockquote) { margin: 1.2rem 0; padding: 0.2rem 1rem; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  .prose :global(li) { margin: 0.25rem 0; }
  .tags { margin-top: 2.5rem; }
  .author { margin-top: 2.5rem; padding: 1rem 1.2rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); font-size: 0.94rem; }
  .author p { margin: 0.15rem 0; }
  .pager { margin-top: 2.5rem; display: flex; justify-content: space-between; gap: 1rem; font-size: 0.92rem; }
  .pager a:last-child { text-align: right; }
</style>
