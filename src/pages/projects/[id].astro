---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getProjects, url, type Project } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props { project: Project; prev?: Project; next?: Project }
const { project, prev, next } = Astro.props;
---
<Base title={project.data.title} description={project.data.summary}>
  <div class="wrap page">
    <p class="no-print back"><a href={url('projects/')}>← All projects</a></p>
    <ProjectDetail project={project} />
    <nav class="pager no-print">
      {prev ? <a href={url(`projects/${prev.id}/`)}>← {prev.data.title}</a> : <span />}
      {next && <a href={url(`projects/${next.id}/`)}>{next.data.title} →</a>}
    </nav>
  </div>
</Base>

<style>
  .page { padding-top: 1.5rem; }
  .back { max-width: 820px; margin: 0 auto 1rem; }
  .pager { max-width: 820px; margin: 3rem auto 0; display: flex; justify-content: space-between; gap: 1rem; font-size: 0.92rem; }
  .pager a:last-child { text-align: right; }
</style>
