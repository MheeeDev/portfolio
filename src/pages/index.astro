---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoCard from '../components/VideoCard.astro';
import HeroTrend from '../components/HeroTrend.astro';
import { categoryLabel, formatDate, getPosts, getProjects, url, youtubeThumb } from '../lib';
import { credentials, site } from '../site';

const projects = await getProjects();
const posts = await getPosts();
// Featured projects if any are marked, otherwise the newest. The first gets the big showcase, the next two sit under it.
const featured = projects.filter((p) => p.data.featured);
const [hero, ...others] = (featured.length ? featured : projects).slice(0, 3);
const [lead, ...rest] = posts;
const morePosts = rest.slice(0, 5);
const latestVideos = posts.filter((p) => p.data.youtube).slice(0, 3);
const platforms = [...new Set(projects.flatMap((p) => p.data.platforms))];

// "Build. Test. Commission. Share." → one span per word so they can rise in turn; the last gets the accent colour.
const words = site.slogan.split(' ');
const stats = [
  { n: projects.length, suffix: '', label: 'projects' },
  { n: credentials.length, suffix: '', label: 'licence & certificates' },
  { n: 90, suffix: '+', label: 'YouTube videos' },
  { n: 3, suffix: '+', label: 'years in automation' },
];
const initials = site.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
const channels = [...site.links, { label: 'Email', href: `mailto:${site.email}` }];
---
<Base>
  <section class="hero">
    <HeroTrend />
    <div class="wrap wide hero-inner">
      <p class="hello rise" lang="th" style="--i:0">
        {site.avatar
          ? <img class="avatar" src={url(site.avatar)} alt={site.name} width="48" height="48" />
          : <span class="avatar initials" aria-hidden="true">{initials}</span>}
        <span>{site.greeting}<span class="caret" aria-hidden="true"></span></span>
      </p>
      <h1 class="slogan" aria-label={site.slogan}>
        {words.map((w, i) => (
          <span class:list={['word', { accent: i === words.length - 1 }]} style={`--i:${i + 1}`} aria-hidden="true">{w}</span>
        ))}
      </h1>
      <p class="slogan-th rise" lang="th" style="--i:5">{site.sloganTh}</p>
      <p class="intro rise" lang="th" style="--i:6">{site.intro}</p>
      <p class="actions rise" style="--i:7">
        {lead
          ? <a class="btn primary big" href={url('blog/')} lang="th">อ่านบทความล่าสุด <span aria-hidden="true">→</span></a>
          : <a class="btn primary big" href={url('projects/')}>See my projects <span aria-hidden="true">→</span></a>}
        <a class="btn big" href={url('about/')} lang="th">รู้จักผม <span aria-hidden="true">→</span></a>
        {site.cvFile && <a class="btn big" href={url(site.cvFile)}>Download CV</a>}
      </p>
      {site.now && <p class="now rise" lang="th" style="--i:8"><span class="led" aria-hidden="true"></span>{site.now}</p>}
    </div>
  </section>

  <section class="stats-band" aria-label="At a glance">
    <ul class="wrap wide stats">
      {stats.map((s) => (
        <li><strong><span data-count={s.n}>{s.n}</span>{s.suffix}</strong><span class="label">{s.label}</span></li>
      ))}
    </ul>
  </section>

  <section class="marquee" aria-label="Platforms I work with">
    <div class="track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {platforms.map((p) => <li>{p}</li>)}
        </ul>
      ))}
    </div>
  </section>

  <section class="wrap wide block">
    <header class="head center" data-reveal>
      <p class="eyebrow">What I do</p>
      <h2 lang="th">สิ่งที่ผมทำ</h2>
      <p class="muted">{site.tagline}</p>
    </header>
    <ul class="tiles">
      {site.services.map((s, i) => (
        <li class="tile spot" data-reveal style={`--d:${i}`}>
          <span class="icon" aria-hidden="true">
            {s.icon === 'plc' && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" /></svg>}
            {s.icon === 'scada' && <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4M6 13l3-4 3 2 4-5 2 3" /></svg>}
            {s.icon === 'network' && <svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="6" rx="1" /><rect x="2" y="16" width="6" height="6" rx="1" /><rect x="16" y="16" width="6" height="6" rx="1" /><path d="M12 8v4M5 16v-2h14v2" /></svg>}
            {s.icon === 'teach' && <svg viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5Z" /><path d="M6 12v5c3 2 9 2 12 0v-5" /></svg>}
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {lead && (
    <section class="wrap wide block" data-reveal>
      <header class="head">
        <h2 lang="th">บทความล่าสุด</h2>
        <p class="muted" lang="th">เรื่องที่ลองทำจริงจากหน้างาน แล้วเอามาเล่าให้ฟัง</p>
      </header>
      <article class="lead-post" lang={lead.data.lang}>
        <a class="lead-cover spot" href={url(`blog/${lead.id}/`)} tabindex="-1" aria-hidden="true">
          {lead.data.cover
            ? <Image src={lead.data.cover} alt="" width={1200} />
            : lead.data.youtube
              ? <img src={youtubeThumb(lead.data.youtube)} alt="" width="480" height="360" />
              : <span class="cover-fallback" lang="en">{categoryLabel(lead.data.category)}</span>}
        </a>
        <div class="lead-body">
          <p class="meta" lang="en">
            <span class="badge" lang="th">ล่าสุด</span>
            <time datetime={lead.data.date.toISOString().slice(0, 10)}>{formatDate(lead.data.date)}</time>
            <span class="cat">{categoryLabel(lead.data.category)}</span>
            {lead.data.draft && <span class="draft">Draft</span>}
          </p>
          <h3><a href={url(`blog/${lead.id}/`)}>{lead.data.title}</a></h3>
          <p class="summary">{lead.data.summary}</p>
          {lead.data.tags.length > 0 && <ul class="tags">{lead.data.tags.map((t) => <li>#{t}</li>)}</ul>}
        </div>
      </article>
      {morePosts.length > 0 && <div class="more-posts">{morePosts.map((p) => <PostCard post={p} />)}</div>}
      <p class="see-all"><a href={url('blog/')} lang="th">ดูบทความทั้งหมด →</a></p>
    </section>
  )}

  {hero && (
    <section class="showcase">
      <div class="wrap wide">
        <header class="head center" data-reveal>
          <p class="eyebrow">Featured project</p>
          <h2>{hero.data.title}</h2>
          <p class="muted lead-line">{hero.data.summary}</p>
          <p class="actions center-row">
            <a class="btn primary big" href={url(`projects/${hero.id}/`)}>Read the case study <span aria-hidden="true">→</span></a>
            <a class="btn big" href={url('projects/')}>All {projects.length} projects</a>
          </p>
        </header>
        <a class="screen spot" href={url(`projects/${hero.id}/`)} tabindex="-1" aria-hidden="true" data-reveal>
          <span class="screen-bar"><i></i><i></i><i></i><span>{hero.data.sector}</span></span>
          <Image src={hero.data.cover} alt="" width={1600} />
        </a>
        {others.length > 0 && <div class="grid two" data-reveal>{others.map((p) => <ProjectCard project={p} />)}</div>}
      </div>
    </section>
  )}

  {latestVideos.length > 0 && (
    <section class="wrap wide block" data-reveal>
      <header class="head">
        <h2 lang="th">วิดีโอล่าสุด</h2>
        <p class="muted" lang="th">ทุกคลิปมีบทความอธิบายประกอบ</p>
      </header>
      <div class="grid">{latestVideos.map((p) => <VideoCard post={p} />)}</div>
      <p class="see-all"><a href={url('videos/')} lang="th">ดูวิดีโอทั้งหมด →</a></p>
    </section>
  )}

  <section class="wrap wide block about" data-reveal>
    <div class="about-grid">
      <div>
        <p class="eyebrow">About</p>
        <h2 lang="th">เกี่ยวกับผม</h2>
        <p class="about-text">
          Automation engineer with three years at system integrators — PLC, HMI and SCADA on Siemens, Rockwell and
          Ignition, and the software around them. A chemical process engineer by degree, so I read the P&amp;ID before the I/O list.
        </p>
        <ul class="creds" aria-label="Licence and certifications">
          {credentials.map((c) => (
            <li><a href={url('about/#credentials')} title={`${c.title} — ${c.issuer}, ${c.date}`}><span class="tick" aria-hidden="true">✓</span>{c.short}</a></li>
          ))}
        </ul>
        <p><a href={url('about/')} lang="th">อ่านเพิ่มเติมเกี่ยวกับผม →</a></p>
      </div>
      <div class="channels">
        <p class="muted" lang="th">ติดตามและติดต่อได้ที่</p>
        {channels.map((c) => (
          <a class="channel spot" href={c.href} rel="noopener"><span>{c.label}</span><span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap wide cta" data-reveal>
      <h2 lang="th">มีงานหรือโปรเจกต์อยากคุยกัน?</h2>
      <p class="muted">For roles, projects or a question about an article, email is the fastest way to reach me.</p>
      <p class="actions center-row">
        <a class="btn primary big" href={url('contact/')} lang="th">ติดต่อผม <span aria-hidden="true">→</span></a>
        <a class="btn big" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Base>

<script>
  // Count the hero numbers up from zero the first time they are seen.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  // The real numbers stay in the HTML; they only reset to 0 when the animation actually starts.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      el.textContent = '0';
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / 1400);
        el.textContent = String(Math.round(target * (1 - (1 - p) ** 3)));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        run(e.target as HTMLElement);
        io.unobserve(e.target);
      }),
    );
    nums.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ---------- Hero: full screen, centred, trend across the whole width ---------- */
  .hero {
    position: relative; overflow: hidden; display: grid; align-items: center;
    min-height: min(92vh, 980px); padding: 5rem 0 4rem; text-align: center;
    background: radial-gradient(70rem 36rem at 50% -10%, var(--bg-glow), transparent 70%);
  }
  /* Dot grid like engineering paper, fading out towards the edges. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--muted) 24%, transparent) 1px, transparent 1.3px) 0 0 / 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 75%);
  }
  /* Soft wash behind the text so the trend never fights with it. */
  .hero::after { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse 50% 45% at 50% 45%, var(--bg) 20%, transparent 75%); opacity: 0.85; }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .hello { display: inline-flex; align-items: center; gap: 0.7rem; margin: 0 0 1.8rem; padding: 0.3rem 1rem 0.3rem 0.3rem; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 75%, transparent); backdrop-filter: blur(6px); font-size: 0.98rem; }
  .avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: #fff; }
  .initials { display: inline-grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.85rem; }
  .caret { display: inline-block; width: 2px; height: 1.1em; margin-left: 3px; vertical-align: -0.18em; background: var(--text); }
  .slogan { font-size: clamp(2.7rem, 8.6vw, 8.4rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.98; margin: 0; max-width: 16ch; }
  .word { display: inline-block; margin-right: 0.22em; }
  .word:last-child { margin-right: 0; }
  .accent {
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent-strong) 45%, #22c55e 70%, var(--accent) 95%);
    background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .slogan-th { font-size: clamp(1.05rem, 2.2vw, 1.5rem); margin: 1.8rem 0 0.5rem; }
  .intro { color: var(--muted); max-width: 44rem; margin: 0; font-size: 1.05rem; }
  .actions { display: flex; align-items: center; justify-content: center; gap: 0.8rem; flex-wrap: wrap; margin: 2.2rem 0 0; }
  .btn.big { padding: 0.8rem 1.5rem; font-size: 1rem; border-radius: 999px; }
  .now { display: inline-flex; align-items: center; gap: 0.6rem; margin: 2rem 0 0; padding: 0.4rem 1rem; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 75%, transparent); font-size: 0.88rem; color: var(--muted); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; flex: none; }

  /* ---------- Stats band ---------- */
  .stats-band { border-block: 1px solid var(--line); background: var(--surface); }
  .stats { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stats li { display: flex; flex-direction: column; align-items: center; padding: 1.8rem 1rem; text-align: center; }
  .stats li + li { border-left: 1px solid var(--line); }
  .stats strong { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stats .label { font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 680px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats li:nth-child(3) { border-left: 0; }
    .stats li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  /* ---------- Platform marquee ---------- */
  .marquee { overflow: hidden; padding: 1.3rem 0; border-bottom: 1px solid var(--line); -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; }
  .marquee ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2.8rem; padding-right: 2.8rem; }
  .marquee li { font-family: var(--mono); font-size: 0.95rem; color: var(--muted); white-space: nowrap; }
  .marquee li::before { content: '◆'; color: var(--accent); font-size: 0.6em; margin-right: 0.9rem; vertical-align: 0.2em; }

  /* ---------- Shared section bits ---------- */
  .block { margin-top: 6rem; }
  .head { margin-bottom: 2rem; }
  .head h2 { font-size: clamp(2rem, 4.6vw, 3.4rem); font-weight: 800; margin: 0; }
  .head p { margin: 0.5rem 0 0; max-width: 46rem; }
  .head.center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .head .eyebrow { margin: 0 0 0.6rem; }
  .center-row { justify-content: center; }
  .see-all { margin: 1.6rem 0 0; font-weight: 500; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1.3rem; }
  .grid.two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); margin-top: 1.3rem; }

  /* ---------- What I do ---------- */
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .tiles { grid-template-columns: 1fr; } }
  .tile { padding: 1.8rem 1.6rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; transition: transform 0.25s, border-color 0.25s; }
  .tile:hover { transform: translateY(-4px); border-color: var(--accent); }
  .icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--accent-soft); color: var(--accent); }
  .icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tile h3 { font-size: 1.2rem; margin: 1.2rem 0 0.4rem; }
  .tile p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* ---------- Latest article ---------- */
  .lead-post { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.5rem; align-items: center; }
  .lead-cover { display: block; aspect-ratio: 16 / 10; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow); transition: transform 0.25s; }
  .lead-cover:hover { transform: translateY(-3px); }
  .lead-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cover-fallback { display: grid; place-items: center; width: 100%; height: 100%; font-family: var(--mono); font-size: 1.6rem; color: var(--accent); background: linear-gradient(135deg, var(--accent-soft), var(--surface)); }
  .lead-body p, .lead-body h3 { margin: 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; font-size: 0.84rem; color: var(--muted); }
  .meta time { font-family: var(--mono); }
  .badge { background: var(--accent-soft); color: var(--accent); border-radius: 6px; padding: 0.05rem 0.55rem; font-weight: 600; }
  .cat { color: var(--accent); font-weight: 600; }
  .draft { background: #fde8c8; color: #7a4a00; border-radius: 4px; padding: 0 0.45rem; }
  .lead-body h3 { font-size: clamp(1.5rem, 3vw, 2.3rem); margin-top: 0.8rem; }
  .lead-body h3 a { color: var(--text); text-decoration: none; }
  .lead-body h3 a:hover { color: var(--accent); }
  .summary { color: var(--muted); margin-top: 0.8rem !important; font-size: 1.02rem; }
  .tags { list-style: none; padding: 0; margin: 0.9rem 0 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; font-size: 0.84rem; color: var(--muted); }
  .more-posts { margin-top: 2.4rem; border-top: 1px solid var(--line); }
  @media (max-width: 860px) { .lead-post { grid-template-columns: 1fr; gap: 1.4rem; } }

  /* ---------- Featured project: a dark full-width band, whatever the page theme ---------- */
  .showcase {
    --bg: #05080c; --surface: #0e141b; --text: #f1f5f9; --muted: #9aa4b0; --line: #1f2a36;
    --accent: #38bdf8; --accent-strong: #7dd3fc; --accent-soft: #0c2a3d; --chip: #18212b; --shadow: 0 20px 60px rgb(0 0 0 / 0.45);
    margin-top: 7rem; padding: 6rem 0; background: radial-gradient(60rem 30rem at 50% 0%, #0f2a3d, transparent 70%), var(--bg); color: var(--text); color-scheme: dark;
  }
  .showcase .head h2 { max-width: 22ch; font-size: clamp(1.9rem, 4.4vw, 3.6rem); }
  .lead-line { font-size: 1.1rem; }
  .screen { display: block; max-width: 1180px; margin: 3rem auto 0; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: #fff; box-shadow: var(--shadow), 0 0 0 1px rgb(255 255 255 / 0.04); transition: transform 0.3s; }
  .screen:hover { transform: translateY(-4px) scale(1.005); }
  .screen-bar { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; background: #111821; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .screen-bar i { width: 10px; height: 10px; border-radius: 50%; background: #2a3542; }
  .screen-bar i:first-child { background: #ef4444; }
  .screen-bar i:nth-child(2) { background: #f59e0b; }
  .screen-bar i:nth-child(3) { background: #22c55e; }
  .screen-bar span { margin-left: 0.6rem; }
  .screen :global(img) { width: 100%; }

  /* ---------- About ---------- */
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; gap: 1.8rem; } }
  .about h2 { font-size: clamp(2rem, 4.6vw, 3.4rem); font-weight: 800; margin: 0 0 1rem; }
  .about .eyebrow { margin: 0 0 0.6rem; }
  .about-text { margin-top: 0; font-size: 1.1rem; max-width: 42rem; }
  .creds { list-style: none; padding: 0; margin: 1.4rem 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .creds a { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.3rem 0.8rem 0.3rem 0.35rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--text); text-decoration: none; font-size: 0.84rem; font-weight: 500; }
  .creds a:hover { border-color: var(--accent); color: var(--accent); }
  .tick { display: inline-grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--accent); color: var(--surface); font-size: 0.72rem; font-weight: 700; }
  .channels { display: flex; flex-direction: column; gap: 0.7rem; padding-top: 2.4rem; }
  .channels p { margin: 0 0 0.2rem; }
