---
import Base from '../layouts/Base.astro';
import { url } from '../lib';
import { site } from '../site';
---
<Base title="Contact" description={`Contact ${site.name} — ${site.headline}.`}>
  <section class="wrap page">
    <h1>Contact</h1>
    <p class="lead">For roles, projects or a question about an article, email is the fastest way to reach me.</p>
    <p lang="th" class="muted">สอบถามเรื่องงาน โปรเจกต์ หรือบทความ ส่งอีเมลมาได้เลยครับ</p>

    <p class="email"><a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a></p>

    <dl class="facts">
      <div><dt>Based in</dt><dd>{site.location}</dd></div>
      <div><dt>Work</dt><dd>{site.headline}</dd></div>
      {site.cvFile && <div><dt>CV</dt><dd><a href={url(site.cvFile)}>Download CV (PDF)</a></dd></div>}
    </dl>

    {site.links.length > 0 && (
      <>
        <h2>Elsewhere</h2>
        <ul class="links">
          {site.links.map((l) => <li><a href={l.href} rel="noopener">{l.label} ↗</a></li>)}
          <li><a href={url('rss.xml')}>Blog RSS feed</a></li>
        </ul>
      </>
    )}
  </section>
</Base>

<style>
  .page { max-width: 820px; padding-top: 2.5rem; }
  .lead { font-size: 1.15rem; margin-bottom: 0.2rem; }
  .email { margin: 1.5rem 0; }
  .email .btn { font-size: 1.05rem; padding: 0.6rem 1.3rem; overflow-wrap: anywhere; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.8rem 1.4rem; padding: 1rem 1.2rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  dd { margin: 0.15rem 0 0; }
  h2 { font-size: 1.1rem; margin-top: 2.2rem; }
  .links { padding-left: 1.2rem; }
  .links li { margin: 0.3rem 0; }
</style>
