---
// Every article with a main clip (`youtube:` in its frontmatter), newest first. One clip = one article.
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import { getPosts } from '../lib';
import { site } from '../site';

const videos = (await getPosts()).filter((p) => p.data.youtube);
const channel = site.links.find((l) => l.label === 'YouTube');
---
<Base title="Videos" description="Automation videos — each one comes with an article that explains it step by step.">
  <section class="wrap page">
    <h1>Videos</h1>
    <p class="muted intro" lang="th">ทุกคลิปมีบทความอธิบายประกอบ กดที่คลิปเพื่ออ่านพร้อมดูได้เลย</p>
    {channel && <p><a class="btn" href={channel.href} rel="noopener">YouTube channel ↗</a></p>}
    {videos.length > 0 ? (
      <div class="grid">{videos.map((p) => <VideoCard post={p} />)}</div>
    ) : (
      <p class="empty muted" lang="th">ยังไม่มีคลิป เร็ว ๆ นี้ครับ</p>
    )}
  </section>
</Base>

<style>
  .page { padding-top: 2.5rem; }
  h1 { margin-bottom: 0.2rem; }
  .intro { margin-top: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.1rem; margin-top: 1.5rem; }
  .empty { padding: 2rem 0; }
</style>
