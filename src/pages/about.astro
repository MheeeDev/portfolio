---
import Base from '../layouts/Base.astro';
import { credentials, site } from '../site';
import { url } from '../lib';

// Job history, newest first. Keep titles identical to the CV.
const experience = [
  {
    title: 'Automation Engineer',
    company: 'MIAC Automation Co., Ltd., Thailand',
    period: 'May 2025 – Present',
    text: 'System integrator — turnkey control and SCADA systems for utility, manufacturing, food and energy plants. Ignition, Rockwell, FactoryTalk Optix, MySQL. Author of the company engineering standards.',
  },
  {
    // TODO: confirm start month — planning files show Jan 2025; the written part-time contract starts Aug 2025
    title: 'Part-time Engineer — Education & Lab Systems',
    company: 'Pranakorn Energy Co., Ltd., Thailand',
    period: 'Jan 2025 – Present',
    text: 'Weekend role alongside a university process-control professor. Built training rigs and the S7-1500 ↔ Simulink digital twin used in class, wrote and recorded an online automation course, and built the AWS cloud lab (InfluxDB, Grafana, Tailscale) that students stream their Simulink runs into. Also a QR-payment vending trainer: FX5U and GOT2000, IoT2050 with MQTT, a Flutter web front end, Node.js webhooks and Omise / PromptPay payments.',
  },
  {
    title: 'Project Engineer / Programmer',
    company: 'P.A.M Engineering & Automation Co., Ltd., Thailand',
    period: 'Sep 2023 – Jan 2025',
    text: 'Siemens PLC and HMI work through to on-site commissioning: the full PLC program and HMI for a big-bag filling line in a vegetable-oil plant, start to end of line; the revised PLC program and conveyor and line HMI screens for a brewery keg-line retrofit from S7-300 to S7-1500; PUT/GET data exchange between an S7-1200 and an S7-300 in a dairy plant; and energy monitoring with electricity cost calculation for a hospital in Energy Manager PRO.',
  },
  {
    title: 'Engineering Intern',
    company: 'P.A.M Engineering & Automation Co., Ltd., Thailand',
    period: 'May 2023 – Sep 2023',
    text: 'PLC and HMI development, testing and support on live projects: a WinCC client/server SCADA for a beverage plant’s water treatment, installation and service visits, Siemens spare parts, and hands-on PLC and HMI training courses for a university.',
  },
];

const skills = [
  ['HMI / SCADA', 'Ignition Perspective & Vision · WinCC Unified (incl. web client) · WinCC client/server · SIMATIC Comfort and KTP panels · FactoryTalk Optix (C# / .NET) · FactoryTalk View ME · GOT2000 · Siemens Energy Manager PRO'],
  ['Control systems', 'Siemens TIA Portal V17 (LAD, STL, SCL), S7-1200 / S7-1500, S7-300 migration · Rockwell Studio 5000, ControlLogix / CompactLogix · Mitsubishi FX5U and GX Works3 · AOI and control-module libraries · Pilz safety relays · Danfoss, ABB, Schneider and Mitsubishi drives · brushed and brushless DC motors · Siemens Industrial Edge'],
  ['Integration', 'OPC UA · MQTT · Node-RED · S7 communication (PUT/GET) · Modbus TCP/RTU · EtherNet/IP · PROFINET · PROFIBUS · SENTRON power meters · protocol gateways · redundant ring networks'],
  ['Software & data', 'C# / .NET · Python (SciPy, pandas, Streamlit, FastAPI) · Flutter web apps · Node.js webhooks and REST APIs · payment gateways (Opn Payments / Omise, PromptPay) · SQL / MySQL / PostgreSQL · InfluxDB · Grafana'],
  ['Design & process engineering', 'Electrical wiring and single-line diagrams · bills of materials · energy calculation and electricity cost · SolidWorks 3D · SolidPlant P&ID · Aspen Plus (Engineering, Energy Analyzer, Exchanger Design & Rating, capital cost estimation)'],
  ['Cloud & infrastructure', 'AWS (EC2, S3, IAM, CloudWatch) · Docker Compose · Tailscale VPN and ACLs · Linux server hardening · backups with restore tests'],
  ['Teaching', 'Course design and video lessons · hands-on lab handouts · training rigs with FAT/SAT protocols · bilingual (EN/TH) runbooks'],
  ['Process control', 'FOPDT identification · IMC λ-tuning · cascade loops · MPC · Simulink digital twins'],
  ['Engineering practice', 'Site survey and retrofits on running lines · Sequence of Operation · PackML / ISA-88 program structure · ISA-5.5 HMI colours · I/O and schematic review · FAT / SAT · commissioning · operator training · engineering standards'],
  ['Ways of working', 'Plan–Do–Check–Act on site · safety checks before every job · teamwork and leadership · problem solving under production pressure · time management · clear communication with operators and clients'],
];
---
<Base title="About" description={`${site.name} — ${site.headline}`}>
  <section class="about-hero">
    <div class="wrap wide hero-grid">
      {site.avatar && (
        <div class="photo-wrap rise" style="--i:0">
          <img class="photo" src={url(site.avatar)} alt={site.name} width="260" height="260" />
          <span class="status"><span class="led" aria-hidden="true"></span>{site.location}</span>
        </div>
      )}
      <div>
        <p class="eyebrow rise" style="--i:1">About</p>
        <h1 class="rise" style="--i:2">{site.name}</h1>
        <p class="headline rise" style="--i:3">{site.headline}</p>
        <p class="lead rise" style="--i:4">
          Automation engineer with three years at system integrators, delivering control logic, HMI and SCADA
          applications on Siemens, Rockwell and Ignition — and the software around them: C#/.NET HMI code, OPC UA,
          MQTT, historians and databases.
        </p>
        <p class="muted rise" style="--i:5">
          My degree is in chemical process engineering. That means I read the P&amp;ID before the I/O list, and I
          build faceplates and alarms for the people who run the process. I work through the whole delivery:
          Sequence of Operation, PLC and SCADA, FAT, commissioning, SAT and operator training.
        </p>
        <p class="actions rise" style="--i:6">
          <a class="btn primary big" href={`mailto:${site.email}`}>Email me</a>
          {site.cvFile && <a class="btn big" href={url(site.cvFile)}>Download CV (PDF)</a>}
          <a class="btn big" href={url('projects/')}>See projects</a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap wide split" data-reveal>
    <div class="side">
      <p class="eyebrow">Career</p>
      <h2 class="section-title">Experience</h2>
      <p class="muted">System integrators and a part-time university role, newest first.</p>
    </div>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <p class="period">{e.period}</p>
          <h3>{e.title}</h3>
          <p class="muted company">{e.company}</p>
          <p>{e.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap wide block" data-reveal>
    <p class="eyebrow">Toolbox</p>
    <h2 class="section-title">Skills</h2>
    <dl class="skills">
      {skills.map(([k, v]) => <div class="skill spot"><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <section class="wrap wide block" data-reveal>
    <p class="eyebrow">Proof</p>
    <h2 class="section-title" id="credentials">Licence &amp; certifications</h2>
    <div class="creds">
      {credentials.map((c) => (
        <article class="cred spot">
          <p class="cred-top"><span class="kind">{c.kind}</span><span class="date">{c.date}</span></p>
          <h3>{c.title}</h3>
          <p class="issuer">{c.issuer}</p>
          <p class="detail">{c.detail}</p>
          {c.file && <p class="view"><a href={url(c.file)} target="_blank" rel="noopener">View certificate →</a></p>}
        </article>
      ))}
    </div>
  </section>

  <section class="wrap wide block" data-reveal>
    <p class="eyebrow">Learning &amp; writing</p>
    <h2 class="section-title">Education &amp; publications</h2>
    <ul class="edu">
      <li class="spot"><span class="tag">Degree</span><strong>B.Eng. Chemical Process Engineering and Technology</strong> — KMUTNB, Rayong Campus (2018–2023). Thesis: <a href={url('projects/2023-thesis-mpc-based-pid/')}><em>Early-stage design and implementation of a model predictive control (MPC) based PID controller for common industrial applications — Phase I</em></a>.</li>
      <li class="spot"><span class="tag">Paper</span>Co-author, <a href={url('papers/tiche2026-digital-twin-batchsep.pdf')} target="_blank" rel="noopener"><em>Digital-Twin-Oriented Pedagogical Integration of BatchSep for Dynamic Modeling and Validation of MeOH/H₂O Batch Distillation</em></a>, TIChE 2026, Pattaya. <a class="pdf" href={url('papers/tiche2026-digital-twin-batchsep.pdf')} target="_blank" rel="noopener" aria-label="Read the paper (PDF)">PDF ↗</a></li>
      <li class="spot"><span class="tag">Channel</span><a href="https://youtube.com/@sureeporn.k" rel="noopener">YouTube channel</a> — 90+ videos on PLC, OPC UA, digital twins and process control.</li>
    </ul>
  </section>
</Base>

<style>
  .about-hero { position: relative; overflow: hidden; padding: 4.5rem 0 4rem; border-bottom: 1px solid var(--line); background: radial-gradient(60rem 26rem at 15% -20%, var(--bg-glow), transparent 70%); }
  .about-hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle, color-mix(in srgb, var(--muted) 24%, transparent) 1px, transparent 1.3px) 0 0 / 22px 22px; -webkit-mask-image: linear-gradient(to bottom, #000, transparent 90%); mask-image: linear-gradient(to bottom, #000, transparent 90%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 3.5rem; align-items: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; gap: 2.4rem; } }
  .photo-wrap { position: relative; justify-self: center; }
  .photo { width: clamp(180px, 22vw, 280px); height: auto; aspect-ratio: 1; border-radius: 32px; object-fit: cover; background: #fff; box-shadow: var(--shadow), 0 0 0 6px var(--surface), 0 0 0 7px var(--line); }
  .status { position: absolute; left: 50%; bottom: -14px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; padding: 0.35rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 0.78rem; color: var(--muted); box-shadow: var(--shadow); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1; margin: 0; }
  .headline { font-size: clamp(1.1rem, 2.2vw, 1.4rem); font-weight: 600; color: var(--accent); margin: 0.6rem 0 1.4rem; }
  .lead { font-size: 1.15rem; max-width: 46rem; }
  .about-hero .muted { max-width: 46rem; }
  .actions { display: flex; gap: 0.7rem; flex-wrap: wrap; margin: 1.8rem 0 0; }
  .eyebrow { margin: 0 0 0.5rem; }

  .block { margin-top: 5.5rem; }
  .split { margin-top: 5rem; display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; gap: 1rem; } }
  .side { position: sticky; top: 90px; align-self: start; }
  @media (max-width: 860px) { .side { position: static; } }
  .timeline { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .timeline li { padding: 0 0 2rem 1.6rem; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -8px; top: 0.3rem; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 3px solid var(--accent); box-sizing: border-box; }
  .timeline li:first-child::before { background: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
  .period { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); margin: 0; letter-spacing: 0.04em; }
  .timeline h3 { margin: 0.2rem 0 0; font-size: 1.2rem; }
  .timeline p { margin: 0.25rem 0; }
  .company { font-size: 0.94rem; }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1rem; margin: 0; }
  .skill { padding: 1.2rem 1.3rem; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; transition: border-color 0.2s; }
  .skill:hover { border-color: var(--accent); }
  .skills dt { font-weight: 700; }
  .skills dd { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.92rem; }

  .creds { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1rem; }
  .cred { background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 16px; padding: 1.1rem 1.2rem 1.2rem; display: flex; flex-direction: column; box-shadow: var(--shadow); overflow: hidden; }
  .cred p, .cred h3 { margin: 0; }
  .cred-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem !important; }
  .kind { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); background: var(--accent-soft); padding: 0.1rem 0.5rem; border-radius: 4px; }
  .date { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
  .cred h3 { font-size: 1.02rem; line-height: 1.35; }
  .issuer { font-size: 0.88rem; color: var(--muted); margin-top: 0.2rem !important; }
  .detail { font-size: 0.9rem; margin-top: 0.6rem !important; }
  .view { margin-top: auto !important; padding-top: 0.8rem; font-size: 0.88rem; font-weight: 600; }

  .edu { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }
  .edu li { padding: 1.1rem 1.3rem; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; }
  .tag { display: inline-block; margin-right: 0.7rem; font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); background: var(--accent-soft); padding: 0.1rem 0.5rem; border-radius: 4px; vertical-align: 0.1em; }
  .edu .pdf { display: inline-block; margin-left: 0.3rem; font: 600 0.72rem var(--mono); padding: 0.1rem 0.5rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; white-space: nowrap; vertical-align: 0.1em; }
  .edu .pdf:hover { border-color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) { .led { animation: led 2s ease-out infinite; } }
  @keyframes led { 0% { box-shadow: 0 0 0 0 rgb(34 197 94 / 0.55); } 70%, 100% { box-shadow: 0 0 0 8px rgb(34 197 94 / 0); } }
</style>
