---
// One project rendered in the standard pattern. Used by the project page and the print page.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { formatPeriod, type Project } from '../lib';

interface Props { project: Project }
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---
<article class="project">
  <header>
    <p class="eyebrow">{d.sector}</p>
    <h1>{d.title}</h1>
    <p class="lead">{d.summary}</p>
  </header>

  <dl class="facts">
    <div><dt>Role</dt><dd>{d.role}</dd></div>
    <div><dt>Company</dt><dd>{d.company}</dd></div>
    <div><dt>Period</dt><dd>{formatPeriod(d.period)}</dd></div>
    <div><dt>Platforms</dt><dd>{d.platforms.join(' · ')}</dd></div>
  </dl>

  <figure class="cover">
    <Image src={d.cover} alt={d.coverAlt} width={1600} />
  </figure>

  <section class="highlights">
    <h2>Highlights</h2>
    <ul>{d.highlights.map((h) => <li>{h}</li>)}</ul>
  </section>

  <div class="prose"><Content /></div>

  <ul class="chips tags">{d.tags.map((t) => <li class="chip">#{t}</li>)}</ul>
</article>

<style>
  .project { max-width: 820px; margin: 0 auto; }
  header h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); margin: 0.3rem 0 0.6rem; }
  .lead { font-size: 1.12rem; color: var(--muted); margin: 0; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.8rem 1.4rem; margin: 1.6rem 0; padding: 1rem 1.2rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts div { min-width: 0; }
  dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  dd { margin: 0.15rem 0 0; font-size: 0.94rem; }
  .cover { margin: 0 0 2rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .cover :global(img) { width: 100%; }
  .highlights { background: var(--accent-soft); border-radius: var(--radius); padding: 0.4rem 1.3rem 0.6rem; margin-bottom: 1rem; }
  .highlights h2 { font-size: 1rem; margin: 0.8rem 0 0.3rem; }
  .highlights ul { margin: 0.3rem 0 0.6rem; padding-left: 1.2rem; }
  .prose :global(h2) { font-size: 1.35rem; margin: 2.4rem 0 0.6rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .prose :global(h3) { font-size: 1.08rem; margin: 1.6rem 0 0.4rem; }
  .prose :global(img) { border: 1px solid var(--line); border-radius: var(--radius); margin: 1rem 0 0.3rem; }
  .tags { margin-top: 2.5rem; }
  @media print {
    .facts, .cover, .highlights, .prose :global(table), .prose :global(pre), .prose :global(img) { break-inside: avoid; }
    .prose :global(h2), .prose :global(h3) { break-after: avoid; }
  }
</style>
