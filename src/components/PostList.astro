---
// The blog listing with its category pills. Used by /blog/ and /blog/category/<id>/.
import PostCard from './PostCard.astro';
import { categories, url, type Category, type Post } from '../lib';

interface Props {
  posts: Post[];
  /** Every published post, so each pill can show its count. */
  all: Post[];
  current?: Category;
}
const { posts, all, current } = Astro.props;
const pills = categories
  .map((c) => ({ ...c, n: all.filter((p) => p.data.category === c.id).length }))
  .filter((c) => c.n > 0);
---
<section class="wrap page">
  <h1>Blog</h1>
  <p class="muted intro" lang="th">แชร์ความรู้งาน Automation จากหน้างานจริง ทั้ง PLC, SCADA, OT/IT และเครื่องมือ AI ที่ใช้ทำงาน</p>
  {pills.length > 0 && (
    <nav class="pills" aria-label="Categories">
      <a class="btn" class:list={[{ primary: !current }]} href={url('blog/')} aria-current={!current ? 'page' : undefined}>All <span class="n">{all.length}</span></a>
      {pills.map((c) => (
        <a class="btn" class:list={[{ primary: current === c.id }]} href={url(`blog/category/${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>
          {c.label} <span class="n">{c.n}</span>
        </a>
      ))}
    </nav>
  )}
  {posts.length > 0 ? (
    <div class="list">{posts.map((p) => <PostCard post={p} />)}</div>
  ) : (
    <p class="empty muted" lang="th">ยังไม่มีบทความ เร็ว ๆ นี้ครับ</p>
  )}
  <p class="rss"><a href={url('rss.xml')}>Subscribe via RSS</a></p>
</section>

<style>
  .page { max-width: 820px; padding-top: 2.5rem; }
  h1 { margin-bottom: 0.2rem; }
  .intro { margin-top: 0; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 1.2rem 0 0.4rem; }
  .pills .btn { padding: 0.25rem 0.85rem; font-size: 0.85rem; }
  .n { opacity: 0.75; font-size: 0.85em; margin-left: 0.15rem; }
  .empty { padding: 2rem 0; }
  .rss { margin-top: 2rem; font-size: 0.9rem; }
</style>
