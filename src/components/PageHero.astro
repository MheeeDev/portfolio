---
// The full-width band at the top of every inner page: dot grid, soft glow, eyebrow, big title and a line under it.
// Anything in the default slot (buttons, pills, stats) goes under the subtitle.
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Language of the subtitle. */
  lang?: 'en' | 'th';
  /** Language of the title. */
  titleLang?: 'en' | 'th';
  center?: boolean;
}
const { eyebrow, title, subtitle, lang = 'en', titleLang = 'en', center = false } = Astro.props;
---
<section class:list={['page-hero', { center }]}>
  <div class="wrap wide inner">
    <slot name="before" />
    <p class="eyebrow rise" style="--i:0">{eyebrow}</p>
    <h1 class="rise" lang={titleLang} style="--i:1">{title}</h1>
    {subtitle && <p class="sub rise" lang={lang} style="--i:2">{subtitle}</p>}
    <div class="extra rise" style="--i:3"><slot /></div>
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; padding: 4.5rem 0 3rem; border-bottom: 1px solid var(--line); background: radial-gradient(60rem 26rem at 80% -20%, var(--bg-glow), transparent 70%); }
  .page-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--muted) 24%, transparent) 1px, transparent 1.3px) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 90%);
    mask-image: linear-gradient(to bottom, #000, transparent 90%);
  }
  .inner { position: relative; }
  .center .inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .eyebrow { margin: 0 0 0.6rem; }
  h1 { font-size: clamp(2.6rem, 7vw, 5.2rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1; margin: 0; }
  h1:lang(th) { line-height: 1.3; letter-spacing: -0.01em; }
  .sub { font-size: clamp(1.02rem, 2vw, 1.3rem); color: var(--muted); max-width: 46rem; margin: 1.1rem 0 0; }
  .extra:empty { display: none; }
  .extra { margin-top: 1.8rem; }
</style>
