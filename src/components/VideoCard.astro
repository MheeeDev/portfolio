---
// A clip's thumbnail linking to its article, where the clip plays.
import { formatDate, url, youtubeThumb, type Post } from '../lib';

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const href = url(`blog/${post.id}/`);
---
<article class="card spot" lang={d.lang}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    <img src={youtubeThumb(d.youtube!)} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="icon"></span>
  </a>
  <div class="body">
    <time datetime={d.date.toISOString().slice(0, 10)} lang="en">{formatDate(d.date)}</time>
    <h3><a href={href}>{d.title}</a></h3>
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform 0.2s, border-color 0.2s; }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .thumb { display: block; position: relative; aspect-ratio: 16 / 9; background: #000; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .icon { position: absolute; left: 50%; top: 50%; width: 52px; height: 36px; transform: translate(-50%, -50%); background: rgb(0 0 0 / 0.7); border-radius: 9px; }
  .icon::after { content: ''; position: absolute; left: 21px; top: 10px; border-style: solid; border-width: 8px 0 8px 13px; border-color: transparent transparent transparent #fff; }
  .thumb:hover .icon { background: #f00; }
  .body { padding: 0.8rem 1rem 1rem; }
  time { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
  h3 { font-size: 1.02rem; margin: 0.2rem 0 0; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
</style>
