---
// Full-width trend behind the home page hero: a setpoint step and the process value settling onto it,
// like a loop trend on an HMI. The curve is a second-order step response, drawn in on page load.
const zeta = 0.3;
const wn = 1.6;
const wd = wn * Math.sqrt(1 - zeta * zeta);
const response = (t: number) =>
  t <= 0 ? 0 : 1 - Math.exp(-zeta * wn * t) * (Math.cos(wd * t) + (zeta / Math.sqrt(1 - zeta * zeta)) * Math.sin(wd * t));

const W = 1600, H = 520, stepAt = 1.4, base = 470, span = 210;
const x = (t: number) => t * 160;
const y = (v: number) => base - v * span;
const pts: string[] = [];
for (let t = 0; t <= 10; t += 0.04) pts.push(`${x(t).toFixed(1)},${y(response(t - stepAt)).toFixed(1)}`);
const pv = `M${pts.join(' L')}`;
const sp = `M0,${y(0)} H${x(stepAt)} V${y(1)} H${W}`;
const end = { x: x(10) - 40, y: y(response(10 - stepAt)) };
const rows = Array.from({ length: 11 }, (_, i) => 30 + i * 44);
const cols = Array.from({ length: 21 }, (_, i) => i * 80);
---
<svg class="trend" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pv-fade" x1="0" x2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.2" />
      <stop offset="0.5" stop-color="currentColor" stop-opacity="1" />
      <stop offset="1" stop-color="#22c55e" stop-opacity="1" />
    </linearGradient>
    <linearGradient id="pv-area" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.16" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
  </defs>
  <g class="grid">
    {rows.map((r) => <line x1="0" x2={W} y1={r} y2={r} />)}
    {cols.map((c) => <line x1={c} x2={c} y1="0" y2={H} />)}
  </g>
  <path class="area" d={`${pv} L${x(10)},${H} L0,${H} Z`} fill="url(#pv-area)" />
  <path class="sp" d={sp} />
  <path class="pv" d={pv} pathLength="1" stroke="url(#pv-fade)" />
  <circle class="dot" cx={end.x} cy={end.y} r="6" />
  <text class="label" x={W - 24} y={y(1) - 12} text-anchor="end">SP 100.0 %</text>
  <text class="label pv-label" x={x(stepAt + 1.9)} y={y(1.4) - 6} text-anchor="middle">PV</text>
</svg>

<style>
  .trend { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--accent); pointer-events: none; z-index: 0; opacity: 0.5; }
  .grid line { stroke: var(--line); stroke-width: 1; opacity: 0.7; }
  .sp { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 8 8; opacity: 0.6; }
  .pv { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .dot { fill: #22c55e; }
  .label { font-family: var(--mono); font-size: 15px; fill: var(--muted); }
  .pv-label { fill: var(--accent); }
  @media (max-width: 760px) { .trend { opacity: 0.3; } }
  @media (prefers-reduced-motion: no-preference) {
    .pv { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 3s 0.3s cubic-bezier(0.35, 0, 0.25, 1) forwards; }
    .area { opacity: 0; animation: appear 1.2s 2s forwards; }
    .dot { opacity: 0; animation: appear 0.5s 3.2s forwards, pulse 2.4s 3.7s ease-in-out infinite; }
    .pv-label { opacity: 0; animation: appear 0.5s 1.2s forwards; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes appear { to { opacity: 1; } }
  @keyframes pulse { 50% { r: 10; opacity: 0.55; } }
</style>
