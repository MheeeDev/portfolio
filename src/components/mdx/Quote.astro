---
// A large pull quote.  <Quote en="English line">Thai line with **bold**</Quote>
// `kicker` is the small mono label above it (defaults to a note-to-self comment).
interface Props {
  en?: string;
  kicker?: string;
}
const { en, kicker = '// NOTE TO SELF' } = Astro.props;
---
<figure class="quote" data-reveal>
  <p class="kicker" lang="en" aria-hidden="true">{kicker}</p>
  <blockquote>
    <div class="th"><slot /></div>
    {en && <p class="en" lang="en">{en}</p>}
  </blockquote>
</figure>

<style>
  .quote { position: relative; margin: 2.6rem 0; padding: 1.8rem 1.6rem 1.6rem 1.9rem; border: 1px solid var(--line); border-radius: 22px; background: radial-gradient(40rem 14rem at 0% 0%, var(--accent-soft), var(--surface) 70%); overflow: hidden; }
  .quote::before { content: '“'; position: absolute; right: 1rem; top: -1.6rem; font: 800 9rem/1 Georgia, serif; color: var(--accent); opacity: 0.12; pointer-events: none; }
  .quote::after { content: ''; position: absolute; left: 0; top: 1.4rem; bottom: 1.4rem; width: 4px; border-radius: 0 4px 4px 0; background: linear-gradient(var(--accent), #a855f7); }
  .kicker { margin: 0 0 0.6rem; font: 600 0.72rem var(--mono); letter-spacing: 0.12em; color: var(--accent); }
  blockquote { margin: 0; padding: 0; border: 0; background: none; }
  /* Overrides the article's default blockquote box. */
  .quote :global(blockquote) { border: 0 !important; background: none !important; padding: 0 !important; margin: 0 !important; }
  .th { font-size: clamp(1.25rem, 2.6vw, 1.7rem); font-weight: 700; line-height: 1.45; letter-spacing: -0.01em; }
  .th :global(p) { margin: 0; }
  /* text-fill-color wins over the article's `.prose strong { color }` rule. */
  .quote .th :global(strong) { background: linear-gradient(90deg, var(--accent), #a855f7); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .en { margin: 0.7rem 0 0; font-size: 0.95rem; font-style: italic; color: var(--muted); }
</style>
