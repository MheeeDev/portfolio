---
// The cloud lab's two design decisions in one widget.
// 1. Write path: every student's Simulink model samples at 1 Hz; a MATLAB helper buffers N seconds and sends
//    one InfluxDB line-protocol request per buffer. Requests per second = students / buffer seconds
//    (120 students, 5 s buffer → 24 requests/s, as in the sizing plan).
// 2. Zero public surface: who can reach what. Only the VPN's UDP port answers from the internet; everything
//    else listens on the tunnel and is allowed by tag. Rules are those described on the project page;
//    combinations the page does not describe are shown as "not in the rules" rather than guessed.
interface Props { title?: string }
const { title = 'Cloud lab: write path and access rules' } = Astro.props;
type V = 'allow' | 'deny' | 'na';
const targets = ['VPN port (UDP)', 'Grafana — view', 'Grafana — build dashboards', 'InfluxDB — write', 'SSH to the server', 'Lab PLC (one address)', 'Other lab hosts'];
const rules: Record<string, { label: string; v: V[]; why: string[] }> = {
  internet: { label: 'Internet, no VPN', v: ['allow', 'deny', 'deny', 'deny', 'deny', 'deny', 'deny'],
    why: ['The only port the security group opens — it answers the VPN handshake and nothing else.', 'Grafana listens on the tunnel interface only.', 'Grafana listens on the tunnel interface only.', 'InfluxDB listens on the tunnel interface only.', 'SSH listens on the tunnel interface only.', 'The lab subnet is routed into the VPN, never to the internet.', 'The lab subnet is routed into the VPN, never to the internet.'] },
  student: { label: 'Student (tag:student)', v: ['allow', 'allow', 'deny', 'allow', 'deny', 'allow', 'deny'],
    why: ['Joins with the student ID as the device name.', 'Every dashboard can be filtered to one student tag.', 'Building dashboards is the instructor role.', 'Writes points tagged with the student ID into the class bucket.', 'Only two admins can log in to the server.', 'A separate rule opens the PLC’s single address — deleted at the end of term.', 'The rule opens one address, not the lab network.'] },
  instructor: { label: 'Instructor (tag:instructor)', v: ['allow', 'allow', 'allow', 'na', 'deny', 'na', 'na'],
    why: ['Joins the VPN like everyone else.', 'Sees every student’s runs.', 'Builds and edits dashboards.', 'Not described in the rules on this page.', 'Only two admins can log in to the server.', 'Not described in the rules on this page.', 'Not described in the rules on this page.'] },
  admin: { label: 'Admin (2 people)', v: ['allow', 'allow', 'allow', 'na', 'allow', 'na', 'na'],
    why: ['Joins the VPN like everyone else.', 'Full access to the dashboards.', 'Full access to the dashboards.', 'Not described in the rules on this page.', 'The only role that can log in to the server.', 'Not described in the rules on this page.', 'Not described in the rules on this page.'] },
};
---
<section class="lp" data-rules={JSON.stringify(rules)}>
  <div class="bar">
    <p class="title">{title}</p>
    <p class="hint">Simulink → buffer → VPN → InfluxDB → Grafana</p>
  </div>

  <div class="part">
    <p class="ph">1 · Write path at peak</p>
    <div class="sliders">
      <label>Students online <output data-out="n">120</output><input type="range" name="n" min="5" max="120" step="1" value="120" /></label>
      <label>Buffer before sending <output data-out="b">5 s</output><input type="range" name="b" min="1" max="10" step="1" value="5" /></label>
    </div>
    <div class="pipe" aria-hidden="true">
      <span class="node">Simulink<small>1 Hz × <b data-out="n2">120</b></small></span>
      <span class="wire"><i class="pk"></i><i class="pk"></i><i class="pk"></i></span>
      <span class="node vpn">Tailscale<small>WireGuard</small></span>
      <span class="wire"><i class="pk"></i><i class="pk"></i><i class="pk"></i></span>
      <span class="node">InfluxDB<small>one bucket</small></span>
      <span class="wire short"></span>
      <span class="node">Grafana<small>filter by student</small></span>
    </div>
    <dl class="metrics">
      <div><dt>Points / s</dt><dd data-out="pts"></dd></div>
      <div><dt>HTTP requests / s</dt><dd data-out="req"></dd></div>
      <div><dt>Points per request</dt><dd data-out="ppr"></dd></div>
      <div><dt>Delay on the dashboard</dt><dd data-out="lag"></dd></div>
    </dl>
  </div>

  <div class="part">
    <p class="ph">2 · Who can reach what</p>
    <div class="seg" role="group" aria-label="Identity">
      {Object.entries(rules).map(([k, r]) => <button type="button" data-who={k} aria-pressed={k === 'student' ? 'true' : 'false'}>{r.label}</button>)}
    </div>
    <ul class="acl">
      {targets.map((t, i) => <li data-i={i}><span class="tgt">{t}</span><span class="verdict"></span><small class="why"></small></li>)}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.lp').forEach((box) => {
    const rules = JSON.parse(box.dataset.rules!);
    const out = (k: string) => box.querySelectorAll<HTMLElement>(`[data-out=${k}]`);
    const n = box.querySelector<HTMLInputElement>('input[name=n]')!;
    const b = box.querySelector<HTMLInputElement>('input[name=b]')!;
    function write() {
      const N = Number(n.value), B = Number(b.value), req = N / B;
      out('n').forEach((e) => (e.textContent = String(N)));
      out('n2').forEach((e) => (e.textContent = String(N)));
      out('b').forEach((e) => (e.textContent = `${B} s`));
      out('pts').forEach((e) => (e.textContent = `${N}`));
      out('req').forEach((e) => { e.textContent = req >= 10 ? req.toFixed(0) : req.toFixed(1); e.className = B === 1 ? 'warn' : 'good'; });
      out('ppr').forEach((e) => (e.textContent = `${B}`));
      out('lag').forEach((e) => { e.textContent = `≈ ${B} s`; e.className = B > 10 ? 'warn' : ''; });
      box.style.setProperty('--speed', `${Math.max(0.5, 3 - req / 50)}s`);
      box.style.setProperty('--gap', `${B / 5}`);
    }
    function acl(who: string) {
      const r = rules[who];
      box.querySelectorAll<HTMLElement>('.acl li').forEach((li) => {
        const i = Number(li.dataset.i), v = r.v[i];
        li.dataset.v = v;
        li.querySelector('.verdict')!.textContent = v === 'allow' ? 'allowed' : v === 'deny' ? 'denied' : 'not in the rules';
        li.querySelector('.why')!.textContent = r.why[i];
      });
    }
    n.addEventListener('input', write);
    b.addEventListener('input', write);
    box.querySelectorAll<HTMLElement>('[data-who]').forEach((btn) => btn.addEventListener('click', () => {
      box.querySelectorAll('[data-who]').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
      acl(btn.dataset.who!);
    }));
    write();
    acl('student');
  });
</script>

<style>
  .lp { --ok: #16a34a; --warn: #d97706; --bad: #dc2626; --speed: 1.5s; margin: 2rem 0; padding: 1.2rem 1.3rem 1.1rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow); }
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1rem; }
  .bar p { margin: 0; }
  .title { font-weight: 700; font-size: 1.08rem; }
  .hint { color: var(--muted); font: 0.78rem var(--mono); }
  .part { margin-top: 1rem; padding: 0.9rem 1rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--chip) 40%, transparent); }
  .ph { margin: 0 0 0.6rem; font: 600 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .sliders { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.4rem; }
  @media (max-width: 600px) { .sliders { grid-template-columns: 1fr; } }
  .sliders label { display: grid; grid-template-columns: 1fr auto; font-size: 0.84rem; color: var(--muted); }
  .sliders output { color: var(--text); font: 600 0.84rem var(--mono); }
  .sliders input { grid-column: 1 / -1; accent-color: var(--accent); }
  .pipe { display: flex; align-items: center; margin: 1rem 0 0.2rem; overflow-x: auto; padding-bottom: 4px; }
  .node { flex: none; display: flex; flex-direction: column; padding: 0.45rem 0.7rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font: 600 0.8rem var(--mono); }
  .node small { font: 0.68rem var(--font); color: var(--muted); font-weight: 400; }
  .node.vpn { border-color: var(--accent); }
  .wire { flex: 1 0 44px; position: relative; height: 2px; margin: 0 4px; background: var(--line); overflow: hidden; }
  .wire.short { flex-basis: 26px; }
  .pk { position: absolute; top: -3px; left: -10px; width: 8px; height: 8px; border-radius: 2px; background: var(--accent); animation: go var(--speed) linear infinite; }
  .pk:nth-child(2) { animation-delay: calc(var(--speed) / 3); }
  .pk:nth-child(3) { animation-delay: calc(var(--speed) * 2 / 3); }
  .wire { overflow: visible; }
  @keyframes go { from { left: -6px; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } to { left: calc(100% - 2px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pk { animation: none; left: 45%; } .pk:nth-child(n + 2) { display: none; } }
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.55rem; margin: 0.9rem 0 0; }
  @media (max-width: 600px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
  .metrics div { padding: 0.55rem 0.7rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  dt { font: 0.64rem var(--mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  dd { margin: 0.2rem 0 0; font-weight: 700; font-size: 1.05rem; }
  dd.good { color: var(--ok); } dd.warn { color: var(--warn); }
  .seg { display: inline-flex; flex-wrap: wrap; padding: 3px; border: 1px solid var(--line); border-radius: 18px; background: var(--chip); }
  .seg button { font: inherit; font-size: 0.8rem; padding: 0.32rem 0.75rem; border: 0; border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--surface); color: var(--text); font-weight: 600; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
  .acl { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .acl li { --c: var(--muted); display: grid; grid-template-columns: minmax(0, 13rem) auto 1fr; align-items: center; gap: 0.2rem 0.8rem; padding: 0.45rem 0.7rem; border: 1px solid color-mix(in srgb, var(--c) 30%, var(--line)); border-left: 4px solid var(--c); border-radius: 10px; background: var(--surface); }
  .acl li[data-v='allow'] { --c: var(--ok); } .acl li[data-v='deny'] { --c: var(--bad); }
  .tgt { font: 600 0.8rem var(--mono); }
  .verdict { font-size: 0.78rem; font-weight: 700; color: var(--c); white-space: nowrap; }
  .why { font-size: 0.76rem; color: var(--muted); line-height: 1.4; }
  @media (max-width: 600px) { .acl li { grid-template-columns: 1fr auto; } .why { grid-column: 1 / -1; } }
</style>
