---
// One row of the instrument list, followed through every layer it generates.
// The Type column picks the AOI, the UDT, the faceplate and the I/O channels to test.
interface Kind {
  id: string;
  type: string;
  count: number;
  plc: string;
  scada: string;
  hmi: string;
  io: string[];
}
const kinds: Kind[] = [
  { id: 'dol', type: 'Line1/DOL', count: 188, plc: 'CM_MotorDOL + MOTOR', scada: 'Motor UDT instance', hmi: 'Motor template · drop target', io: ['DI remote switch', 'DI run feedback', 'DO start'] },
  { id: 'vsd', type: 'Line1/VSD', count: 42, plc: 'CM_MotorVSD + MOTOR', scada: 'Motor UDT instance', hmi: 'Motor template · speed % and Hz', io: ['DI remote switch', 'DI run feedback', 'DO run', 'AO speed reference'] },
  { id: 'valve', type: 'Line1/Valve', count: 26, plc: 'CM_Valve + VALVE', scada: 'Valve UDT instance', hmi: 'Valve template', io: ['DO open', 'DI feedback (0, 1 or 2 positions)'] },
  { id: 'ai', type: 'Line1/Analog_in', count: 81, plc: 'CM_AI + AI', scada: 'Analog Input UDT instance', hmi: 'AI template (20×60 … small)', io: ['AI 4–20 mA, scaled with alarm limits'] },
];
const layers = [
  { key: 'type', step: '01', name: 'Instrument list', sub: 'Excel row' },
  { key: 'plc', step: '02', name: 'PLC', sub: 'Studio 5000 · CSV import' },
  { key: 'scada', step: '03', name: 'SCADA tags', sub: 'Ignition · JSON import' },
  { key: 'hmi', step: '04', name: 'Screen', sub: 'Vision template' },
  { key: 'io', step: '05', name: 'FAT row', sub: 'I/O channels to test' },
];
interface TitleProps { title?: string }
const { title = 'One row in, five layers out' } = Astro.props as TitleProps;
---
<section class="flow" data-kind="dol">
  <div class="bar">
    <p class="title">{title}</p>
    <div class="pick" role="tablist" aria-label="Device type">
      {kinds.map((k, i) => (
        <button type="button" role="tab" data-kind={k.id} aria-selected={i === 0 ? 'true' : 'false'}>{k.type.split('/')[1].replace('_', ' ')}</button>
      ))}
    </div>
  </div>

  {kinds.map((k, i) => (
    <div class="panel" data-for={k.id} hidden={i !== 0}>
      <ol class="layers">
        {layers.map((l) => (
          <li>
            <span class="step">{l.step}</span>
            <span class="name">{l.name}<small>{l.sub}</small></span>
            {l.key === 'io' ? (
              <span class="val"><ul>{k.io.map((s) => <li>{s}</li>)}</ul></span>
            ) : (
              <code class="val">{l.key === 'type' ? `Type = ${k.type}` : (k as any)[l.key]}</code>
            )}
          </li>
        ))}
      </ol>
      <p class="count"><b>{k.count}</b> devices of this type in the instrument list, all made the same way.</p>
    </div>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.flow').forEach((box) => {
    const tabs = box.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        box.dataset.kind = t.dataset.kind;
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        box.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.hidden = p.dataset.for !== t.dataset.kind));
      }),
    );
  });
</script>

<style>
  .flow { margin: 2rem 0; padding: 1.2rem 1.3rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .title { margin: 0; font-weight: 700; }
  .pick { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip); }
  .pick button { border: 0; background: none; padding: 0.35rem 0.85rem; border-radius: 999px; font: 600 0.82rem var(--mono); color: var(--muted); cursor: pointer; }
  .pick button[aria-selected='true'] { background: var(--accent); color: var(--surface); }
  .panel[hidden] { display: none; }
  .layers { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .layers > li { position: relative; display: grid; grid-template-columns: 2.2rem minmax(0, 11rem) minmax(0, 1fr); align-items: center; gap: 0.8rem; padding: 0.65rem 0; }
  .layers > li + li { border-top: 1px dashed var(--line); }
  .step { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font: 700 0.78rem var(--mono); }
  .name { font-weight: 700; font-size: 0.95rem; line-height: 1.25; }
  .name small { display: block; font-weight: 400; font-size: 0.75rem; color: var(--muted); font-family: var(--mono); }
  .val { font-size: 0.86rem; min-width: 0; overflow-wrap: anywhere; }
  code.val { justify-self: start; padding: 0.25rem 0.6rem; border-radius: 8px; background: var(--chip); font-family: var(--mono); }
  .val ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 4px; }
  .val ul li { padding: 0.2rem 0.55rem; border-radius: 999px; border: 1px solid var(--line); font: 0.78rem var(--mono); }
  .count { margin: 0.9rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .count b { color: var(--accent); font-size: 1.1rem; }
  @media (max-width: 560px) {
    .layers > li { grid-template-columns: 2.2rem minmax(0, 1fr); }
    .val { grid-column: 2; }
  }
</style>
