---
// The phase-2 change on one turbo-cyclone station, drawn as a faceplate.
// Switch the drive from DOL to VSD: only the control module under VISU changes, the screen keeps its binding.
// Move the vibration: the TB valve opens below the setpoint and closes above it.
interface TitleProps { title?: string }
const { title = 'TB4/1 faceplate — phase 2 change' } = Astro.props as TitleProps;
---
<section class="tbfp" data-drive="dol" data-valve="open">
  <div class="bar">
    <p class="title">{title}</p>
    <div class="pick" role="radiogroup" aria-label="Drive type">
      <button type="button" role="radio" data-drive="dol" aria-checked="true">DOL</button>
      <button type="button" role="radio" data-drive="vsd" aria-checked="false">VSD</button>
    </div>
  </div>

  <div class="grid">
    <div class="face">
      <p class="lbl">Motor</p>
      <p class="big run">● Running · Auto</p>
      <div class="vsd-only">
        <label class="row">
          <span>Speed</span>
          <input type="range" class="speed" min="0" max="100" value="100" aria-label="Speed reference in percent" />
          <output class="spd">100 %</output>
        </label>
        <p class="hz"><b class="hzv">50.0</b> Hz</p>
      </div>
      <p class="dol-only muted small">On / off contactor — no speed reference</p>
    </div>

    <div class="face">
      <p class="lbl">Vibration</p>
      <label class="row">
        <span>PV</span>
        <input type="range" class="vib" min="0" max="10" step="0.1" value="3.2" aria-label="Vibration" />
        <output class="vibv">3.2</output>
      </label>
      <label class="row">
        <span>SP</span>
        <input type="range" class="sp" min="1" max="9" step="0.1" value="6" aria-label="Vibration setpoint" />
        <output class="spv">6.0</output>
      </label>
      <p class="big valve"><span class="v-open">Valve TB · OPEN</span><span class="v-closed">Valve TB · CLOSED</span></p>
    </div>
  </div>

  <ol class="chain" aria-label="Binding from screen to PLC">
    <li>Faceplate</li>
    <li class="same">VISU<small>unchanged</small></li>
    <li class="cm"><span class="dol-only">CM_MotorDOL</span><span class="vsd-only">CM_MotorVSD</span><small>swapped</small></li>
    <li><span class="dol-only">DO start</span><span class="vsd-only">DO run + AO speed</span></li>
  </ol>
  <p class="muted small note">Illustrative values. The rule matches the PLC: vibration under the setpoint opens the TB valve, over it closes the valve.</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.tbfp').forEach((box) => {
    const q = <T extends Element>(s: string) => box.querySelector<T>(s)!;
    const speed = q<HTMLInputElement>('.speed');
    const vib = q<HTMLInputElement>('.vib');
    const sp = q<HTMLInputElement>('.sp');

    const update = () => {
      q('.spd').textContent = `${speed.value} %`;
      q('.hzv').textContent = ((Number(speed.value) * 50) / 100).toFixed(1);
      q('.vibv').textContent = Number(vib.value).toFixed(1);
      q('.spv').textContent = Number(sp.value).toFixed(1);
      box.dataset.valve = Number(vib.value) > Number(sp.value) ? 'closed' : 'open';
    };

    box.querySelectorAll<HTMLButtonElement>('[role="radio"]').forEach((b) =>
      b.addEventListener('click', () => {
        box.dataset.drive = b.dataset.drive;
        box.querySelectorAll('[role="radio"]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      }),
    );
    [speed, vib, sp].forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

<style>
  .tbfp { margin: 2rem 0; padding: 1.2rem 1.3rem; border: 1px solid var(--line); border-radius: 20px; background: radial-gradient(circle at 80% 0%, var(--accent-soft), var(--surface) 60%); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .title { margin: 0; font-weight: 700; }
  .pick { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip); }
  .pick button { border: 0; background: none; padding: 0.35rem 1rem; border-radius: 999px; font: 600 0.85rem var(--mono); color: var(--muted); cursor: pointer; }
  .pick button[aria-checked='true'] { background: var(--accent); color: var(--surface); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 0.8rem; }
  .face { padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .face p { margin: 0; }
  .lbl { font: 600 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.5rem !important; }
  .big { font-weight: 700; font-size: 1rem; margin-top: 0.4rem !important; }
  .run { color: #16a34a; }
  .row { display: grid; grid-template-columns: 3rem 1fr 3.4rem; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin: 0.35rem 0; }
  .row input { width: 100%; accent-color: var(--accent); }
  output { font: 600 0.85rem var(--mono); text-align: right; }
  .hz { font-size: 0.9rem; }
  .hz b { font: 800 1.6rem var(--font); color: var(--accent); }
  .small { font-size: 0.82rem; }
  [data-drive='dol'] .vsd-only, [data-drive='vsd'] .dol-only { display: none; }
  .valve span { padding: 0.2rem 0.6rem; border-radius: 8px; }
  .v-open { background: color-mix(in srgb, #22c55e 18%, transparent); color: #16a34a; }
  .v-closed { background: color-mix(in srgb, #dc2626 15%, transparent); color: #dc2626; }
  [data-valve='open'] .v-closed, [data-valve='closed'] .v-open { display: none; }
  .chain { list-style: none; display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.4rem; margin: 1rem 0 0.4rem; padding: 0; }
  .chain li { display: flex; flex-direction: column; justify-content: center; padding: 0.4rem 0.75rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font: 600 0.82rem var(--mono); }
  .chain li + li::before { content: '→'; position: absolute; margin-left: -1.05rem; color: var(--muted); }
  .chain li { position: relative; margin-left: 0.5rem; }
  .chain li:first-child { margin-left: 0; }
  .chain small { font-weight: 400; font-size: 0.7rem; color: var(--muted); }
  .chain .same { border-color: #22c55e; }
  .chain .cm { border-color: var(--accent); color: var(--accent); }
  .note { margin: 0.4rem 0 0; }
</style>
