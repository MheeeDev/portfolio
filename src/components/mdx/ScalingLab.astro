---
// The course's 4–20 mA scaling lesson as a widget. A transmitter current becomes the raw INT an S7-1500
// analog input reports (nominal 4–20 mA → 0–27648, overrange to 22.81 mA → 32511, underrange down to
// 1.185 mA → −4864, beyond that overflow 32767 / underflow −32768), then NORM_X and SCALE_X turn it into
// engineering units. A second line shows the classic mistake: normalising over 0–32767 instead of 0–27648.
interface Props { title?: string }
const { title = '4–20 mA → raw → engineering units' } = Astro.props;
---
<section class="sl">
  <div class="bar">
    <p class="title">{title}</p>
    <p class="hint">S7-1500 analog input · NORM_X → SCALE_X</p>
  </div>

  <label class="ma">Transmitter current <output>12.00 mA</output>
    <input type="range" min="0" max="24" step="0.01" value="12" aria-label="Transmitter current in milliamps" />
  </label>
  <div class="presets" role="group" aria-label="Presets">
    <button type="button" data-ma="4">4 mA</button>
    <button type="button" data-ma="12">12 mA</button>
    <button type="button" data-ma="20">20 mA</button>
    <button type="button" data-ma="21.5">21.5 mA</button>
    <button type="button" data-ma="0">wire break</button>
  </div>

  <div class="range">
    <span>Transmitter range</span>
    <label>low <input type="number" name="lo" value="0" step="any" /></label>
    <label>high <input type="number" name="hi" value="10" step="any" /></label>
    <label>unit <input type="text" name="u" value="bar" maxlength="6" /></label>
  </div>

  <div class="flow">
    <div class="st"><small>Signal</small><b class="v-ma"></b><span class="badge"></span></div>
    <span class="ar">→</span>
    <div class="st"><small>Raw INT (%IW)</small><b class="v-raw"></b><code class="v-hex"></code></div>
    <span class="ar">→</span>
    <div class="st"><small>NORM_X 0…27648</small><b class="v-norm"></b></div>
    <span class="ar">→</span>
    <div class="st eu"><small>SCALE_X</small><b class="v-eu"></b></div>
  </div>

  <div class="bars" aria-hidden="true">
    <div class="track"><i class="zone under"></i><i class="zone nom"></i><i class="zone over"></i><i class="needle"></i></div>
    <div class="ticks"><span style="left:4.94%">1.185</span><span style="left:16.67%">4</span><span style="left:83.33%">20</span><span style="left:95.04%">22.81 mA</span></div>
  </div>

  <p class="wrong"></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.sl').forEach((box) => {
    const $ = <T extends Element = HTMLElement>(s: string) => box.querySelector<T>(s)!;
    const ma = $<HTMLInputElement>('.ma input');
    const lo = $<HTMLInputElement>('[name=lo]'), hi = $<HTMLInputElement>('[name=hi]'), un = $<HTMLInputElement>('[name=u]');
    const fmt = (v: number) => (Math.abs(v) >= 100 ? v.toFixed(1) : v.toFixed(2));
    function raw(I: number) {
      if (I > 22.81) return { r: 32767, s: 'overflow', c: 'bad' };
      if (I < 1.185) return { r: -32768, s: 'underflow · wire break?', c: 'bad' };
      const r = Math.round(((I - 4) / 16) * 27648);
      return r > 27648 ? { r, s: 'overrange', c: 'warn' } : r < 0 ? { r, s: 'underrange', c: 'warn' } : { r, s: 'nominal', c: 'good' };
    }
    function draw() {
      const I = Number(ma.value), L = Number(lo.value), H = Number(hi.value), U = un.value || '';
      const { r, s, c } = raw(I);
      const valid = Math.abs(r) < 32767;
      const norm = r / 27648, eu = L + norm * (H - L);
      $('.ma output').textContent = `${I.toFixed(2)} mA`;
      $('.v-ma').textContent = `${I.toFixed(2)} mA`;
      const badge = $('.badge'); badge.textContent = s; badge.className = `badge ${c}`;
      $('.v-raw').textContent = String(r);
      $('.v-hex').textContent = `16#${(r & 0xffff).toString(16).toUpperCase().padStart(4, '0')}`;
      $('.v-norm').textContent = valid ? norm.toFixed(4) : '—';
      $('.v-eu').textContent = valid ? `${fmt(eu)} ${U}` : 'invalid — alarm';
      $('.eu').className = `st eu ${valid ? '' : 'bad'}`;
      $<HTMLElement>('.needle').style.left = `${(Math.min(24, I) / 24) * 100}%`;
      const wrongEu = L + (r / 32767) * (H - L), err = H !== L ? ((wrongEu - eu) / (H - L)) * 100 : 0;
      $('.wrong').innerHTML = valid
        ? `Normalised over <b>0…32767</b> by mistake: <b>${fmt(wrongEu)} ${U}</b> instead of ${fmt(eu)} ${U} — <span>${err.toFixed(1)} % of span</span> wrong${I >= 19.9 && I <= 20.1 ? ', and full scale never reaches the top of the range' : ''}.`
        : `Outside the measuring range the module reports ${r} — treat it as a fault, not as a value.`;
    }
    [ma, lo, hi, un].forEach((el) => el.addEventListener('input', draw));
    box.querySelectorAll<HTMLElement>('[data-ma]').forEach((b) => b.addEventListener('click', () => { ma.value = b.dataset.ma!; draw(); }));
    draw();
  });
</script>

<style>
  .sl { --ok: #16a34a; --warn: #d97706; --bad: #dc2626; margin: 2rem 0; padding: 1.2rem 1.3rem 1.1rem; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow); }
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1rem; }
  .bar p { margin: 0; }
  .title { font-weight: 700; font-size: 1.08rem; }
  .hint { color: var(--muted); font: 0.78rem var(--mono); }
  .ma { display: grid; grid-template-columns: 1fr auto; margin-top: 1rem; font-size: 0.85rem; color: var(--muted); }
  .ma output { font: 700 0.95rem var(--mono); color: var(--text); }
  .ma input { grid-column: 1 / -1; accent-color: var(--accent); }
  .presets { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.5rem 0 0.8rem; }
  .presets button { font: 0.76rem var(--mono); padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; background: var(--chip); color: var(--text); cursor: pointer; }
  .presets button:hover { border-color: var(--accent); }
  .range { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; font-size: 0.8rem; color: var(--muted); }
  .range input { width: 4.6rem; font: 0.82rem var(--mono); padding: 0.25rem 0.4rem; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text); }
  .flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.4rem; margin: 1rem 0 0.8rem; }
  .st { flex: 1 1 8.5rem; display: flex; flex-direction: column; gap: 0.15rem; padding: 0.6rem 0.75rem; border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, var(--chip) 45%, transparent); }
  .st small { font: 0.64rem var(--mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .st b { font: 700 1.1rem var(--mono); }
  .st code { font-size: 0.72rem; color: var(--muted); }
  .st.eu { border-color: var(--accent); }
  .st.eu b { color: var(--accent); }
  .st.eu.bad b { color: var(--bad); font-size: 0.95rem; }
  .ar { align-self: center; color: var(--muted); }
  @media (max-width: 600px) { .ar { display: none; } .st { flex-basis: 40%; } }
  .badge { align-self: flex-start; font: 600 0.68rem var(--mono); padding: 0.1rem 0.45rem; border-radius: 999px; background: var(--chip); }
  .badge.good { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
  .badge.warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 14%, transparent); }
  .badge.bad { color: var(--bad); background: color-mix(in srgb, var(--bad) 12%, transparent); }
  .bars { margin: 0.4rem 0 0; }
  .track { position: relative; height: 12px; border-radius: 6px; background: color-mix(in srgb, var(--bad) 18%, var(--chip)); }
  .zone { position: absolute; top: 0; bottom: 0; }
  .under { left: 4.94%; width: 11.73%; background: color-mix(in srgb, var(--warn) 35%, transparent); }
  .nom { left: 16.67%; width: 66.66%; background: color-mix(in srgb, var(--ok) 40%, transparent); }
  .over { left: 83.33%; width: 11.71%; background: color-mix(in srgb, var(--warn) 35%, transparent); }
  .needle { position: absolute; top: -4px; width: 4px; height: 20px; margin-left: -2px; border-radius: 2px; background: var(--text); transition: left 0.1s; }
  .ticks { position: relative; height: 1.2rem; font: 0.66rem var(--mono); color: var(--muted); }
  .ticks span { position: absolute; top: 2px; transform: translateX(-50%); white-space: nowrap; }
  .ticks span:last-child { transform: translateX(-80%); }
  .wrong { margin: 0.6rem 0 0; padding: 0.6rem 0.8rem; border-left: 4px solid var(--warn); border-radius: 8px; background: color-mix(in srgb, var(--warn) 8%, var(--surface)); font-size: 0.84rem; }
  .wrong :global(span) { color: var(--bad); font-weight: 700; }
</style>
